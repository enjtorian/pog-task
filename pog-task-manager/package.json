{
    "name": "pog-task-manager",
    "displayName": "POG Task Manager",
    "icon": "assets/POG-Task-Manager.png",
    "description": "POG Task Management Plugin",
    "publisher": "enjtorian",
    "license": "Apache-2.0",
    "version": "1.3.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/enjtorian/pog-task.git"
    },
    "bugs": {
        "url": "https://github.com/enjtorian/pog-task/issues"
    },
    "homepage": "https://enjtorian.github.io/pog-task/",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other",
        "Visualization",
        "AI",
        "SCM Providers"
    ],
    "keywords": [
        "pog task",
        "task manager",
        "ai"
    ],
    "activationEvents": [
        "workspaceContains:pog-task/list/**/*.yaml",
        "workspaceContains:pog-task/**"
    ],
    "main": "./dist/extension.js",
    "extensionKind": [
        "ui",
        "workspace"
    ],
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "pog-task-manager",
                    "title": "POG Task Manager",
                    "icon": "$(checklist)"
                }
            ]
        },
        "views": {
            "pog-task-manager": [
                {
                    "id": "pog-task-manager.taskList",
                    "name": "Task List",
                    "icon": "$(checklist)",
                    "when": "pog-task-manager.pogTaskInitialized"
                },
                {
                    "id": "pog-task-manager.welcome",
                    "name": "Welcome",
                    "when": "!pog-task-manager.pogTaskInitialized"
                },
                {
                    "id": "pog-task-manager.issueTaskList",
                    "name": "Issue Tasks",
                    "icon": "$(issue-opened)",
                    "when": "pog-task-manager.pogTaskInitialized"
                },
                {
                    "id": "pog-task-manager.promptTemplates",
                    "name": "Prompt Templates",
                    "icon": "$(megaphone)",
                    "when": "pog-task-manager.pogTaskInitialized"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "pog-task-manager.welcome",
                "contents": "POG Task is not initialized in this workspace.\n[Init POG Task](command:pog-task-manager.initPogTask)\nThis will download the required configuration files and create the initial task structure."
            }
        ],
        "commands": [
            {
                "command": "pog-task-manager.refreshTasks",
                "title": "POG Task Manager: Refresh Tasks",
                "icon": "$(refresh)"
            },
            {
                "command": "pog-task-manager.refreshIssueTasks",
                "title": "POG Task Manager: Refresh Issue Tasks",
                "icon": "$(refresh)"
            },
            {
                "command": "pog-task-manager.jira.pullTodos",
                "title": "POG Task Manager: Jira — Pull Todos",
                "icon": "$(cloud-download)"
            },
            {
                "command": "pog-task-manager.jira.pushSelected",
                "title": "POG Task Manager: Jira — Push Selected",
                "icon": "$(cloud-upload)"
            },
            {
                "command": "pog-task-manager.jira.setCredentials",
                "title": "POG Task Manager: Jira — Set Connection",
                "icon": "$(gear)"
            },
            {
                "command": "pog-task-manager.initPogTask",
                "title": "POG Task Manager: Init POG Task",
                "icon": "$(rocket)"
            },
            {
                "command": "pog-task-manager.openTaskDetail",
                "title": "POG Task Manager: Open Task Detail"
            },
            {
                "command": "pog-task-manager.quickAdd",
                "title": "POG Task Manager: Quick Add Task",
                "icon": "$(add)"
            },
            {
                "command": "pog-task-manager.copyExecutePrompt",
                "title": "POG Task Manager: Copy Task Execute",
                "icon": "$(play)"
            },
            {
                "command": "pog-task-manager.copyContext",
                "title": "POG Task Manager: Copy Task Context",
                "icon": "$(copy)"
            },
            {
                "command": "pog-task-manager.copyCreatePrompt",
                "title": "POG Task Manager: Copy Task Create",
                "icon": "$(add)"
            },
            {
                "command": "pog-task-manager.refreshPromptTemplates",
                "title": "POG Task Manager: Refresh Prompt Templates",
                "icon": "$(refresh)"
            },
            {
                "command": "pog-task-manager.copyPromptTemplate",
                "title": "POG Task Manager: Copy Prompt Template",
                "icon": "$(copy)"
            },
            {
                "command": "pog-task-manager.previewPromptTemplate",
                "title": "POG Task Manager: Preview Prompt Template",
                "icon": "$(eye)"
            },
            {
                "command": "pog-task-manager.openPromptTemplateFile",
                "title": "POG Task Manager: Open Prompt Template File",
                "icon": "$(go-to-file)"
            },
            {
                "command": "pog-task-manager.filterByStatus",
                "title": "POG Task Manager: Filter Tasks by Status",
                "icon": "$(filter)"
            },
            {
                "command": "pog-task-manager.clearFilter",
                "title": "POG Task Manager: Clear Task Filter",
                "icon": "$(clear-all)"
            },
            {
                "command": "pog-task-manager.collapseAll",
                "title": "POG Task Manager: Collapse All Tasks",
                "icon": "$(collapse-all)"
            },
            {
                "command": "pog-task-manager.expandAll",
                "title": "POG Task Manager: Expand All Tasks",
                "icon": "$(expand-all)"
            },
            {
                "command": "pog-task-manager.toggleContextAware",
                "title": "POG Task Manager: Toggle Context Awareness",
                "icon": "$(magnet)",
                "enablement": "true"
            },
            {
                "command": "pog-task-manager.initPogTaskPrompt",
                "title": "POG Task Manager: Init Prompt Templates",
                "icon": "$(cloud-download)"
            },
            {
                "command": "pog-task-manager.openDashboard",
                "title": "POG Task Manager: Open Dashboard",
                "icon": "$(dashboard)"
            },
            {
                "command": "pog-task-manager.openIssueDashboard",
                "title": "POG Task Manager: Open Issue Task Dashboard",
                "icon": "$(graph)"
            },
            {
                "command": "pog-task-manager.copyAnalyzePrompt",
                "title": "POG Task Manager: Copy Task Analyze",
                "icon": "$(search)"
            },
            {
                "command": "pog-task-manager.jira.pushIssueTask",
                "title": "POG Task Manager: Jira — Push This Issue",
                "icon": "$(cloud-upload)"
            },
            {
                "command": "pog-task-manager.createPromptForProject",
                "title": "POG Task Manager: Copy Create Task for Project",
                "icon": "$(add)"
            },
            {
                "command": "pog-task-manager.createPromptForModule",
                "title": "POG Task Manager: Copy Create Task for Module",
                "icon": "$(add)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "pog-task-manager.openDashboard",
                    "when": "view == pog-task-manager.taskList",
                    "group": "navigation@0"
                },
                {
                    "command": "pog-task-manager.quickAdd",
                    "when": "view == pog-task-manager.taskList",
                    "group": "navigation@1"
                },
                {
                    "command": "pog-task-manager.refreshTasks",
                    "when": "view == pog-task-manager.taskList",
                    "group": "navigation@2"
                },
                {
                    "command": "pog-task-manager.filterByStatus",
                    "when": "view == pog-task-manager.taskList",
                    "group": "navigation@3"
                },
                {
                    "command": "pog-task-manager.clearFilter",
                    "when": "view == pog-task-manager.taskList",
                    "group": "navigation@4"
                },
                {
                    "command": "pog-task-manager.collapseAll",
                    "when": "view == pog-task-manager.taskList",
                    "group": "navigation@5"
                },
                {
                    "command": "pog-task-manager.expandAll",
                    "when": "view == pog-task-manager.taskList",
                    "group": "navigation@6"
                },
                {
                    "command": "pog-task-manager.openIssueDashboard",
                    "when": "view == pog-task-manager.issueTaskList",
                    "group": "navigation@-1"
                },
                {
                    "command": "pog-task-manager.jira.pullTodos",
                    "when": "view == pog-task-manager.issueTaskList",
                    "group": "navigation@0"
                },
                {
                    "command": "pog-task-manager.jira.pushSelected",
                    "when": "view == pog-task-manager.issueTaskList",
                    "group": "navigation@1"
                },
                {
                    "command": "pog-task-manager.jira.setCredentials",
                    "when": "view == pog-task-manager.issueTaskList",
                    "group": "navigation@2"
                },
                {
                    "command": "pog-task-manager.refreshIssueTasks",
                    "when": "view == pog-task-manager.issueTaskList",
                    "group": "navigation@3"
                },
                {
                    "command": "pog-task-manager.refreshPromptTemplates",
                    "when": "view == pog-task-manager.promptTemplates",
                    "group": "navigation"
                },
                {
                    "command": "pog-task-manager.initPogTaskPrompt",
                    "when": "view == pog-task-manager.promptTemplates",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "pog-task-manager.copyExecutePrompt",
                    "when": "view == pog-task-manager.taskList && viewItem == task",
                    "group": "inline"
                },
                {
                    "command": "pog-task-manager.createPromptForProject",
                    "when": "view == pog-task-manager.taskList && viewItem == project",
                    "group": "inline"
                },
                {
                    "command": "pog-task-manager.createPromptForModule",
                    "when": "view == pog-task-manager.taskList && viewItem == module",
                    "group": "inline"
                },
                {
                    "command": "pog-task-manager.copyContext",
                    "when": "view == pog-task-manager.taskList && viewItem == task",
                    "group": "inline"
                },
                {
                    "command": "pog-task-manager.copyCreatePrompt",
                    "when": "view == pog-task-manager.taskList && viewItem == task",
                    "group": "inline"
                },
                {
                    "command": "pog-task-manager.copyAnalyzePrompt",
                    "when": "view == pog-task-manager.issueTaskList && viewItem == issueTask",
                    "group": "inline@1"
                },
                {
                    "command": "pog-task-manager.copyExecutePrompt",
                    "when": "view == pog-task-manager.issueTaskList && viewItem == issueTask",
                    "group": "inline@2"
                },
                {
                    "command": "pog-task-manager.jira.pushIssueTask",
                    "when": "view == pog-task-manager.issueTaskList && viewItem == issueTask",
                    "group": "inline@3"
                },
                {
                    "command": "pog-task-manager.copyPromptTemplate",
                    "when": "view == pog-task-manager.promptTemplates && viewItem == promptTemplate",
                    "group": "inline"
                },
                {
                    "command": "pog-task-manager.openPromptTemplateFile",
                    "when": "view == pog-task-manager.promptTemplates && viewItem == promptTemplate",
                    "group": "1_actions"
                },
                {
                    "command": "pog-task-manager.previewPromptTemplate",
                    "when": "view == pog-task-manager.promptTemplates && viewItem == promptTemplate",
                    "group": "1_actions"
                }
            ]
        },
        "configuration": {
            "title": "POG Task Manager",
            "properties": {
                "pog.taskManager.taskDirectories": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "./pog-task/list"
                    ],
                    "description": "Directories containing task YAML files."
                },
                "pog.taskManager.promptTemplateDirectory": {
                    "type": "string",
                    "default": "./pog-task/prompts",
                    "description": "Directory containing prompt templates."
                },
                "pog.taskManager.promptListApiUrl": {
                    "type": "string",
                    "default": "https://task.pog-ai.net/vscode-plugin/index.json",
                    "description": "API URL to fetch the list of prompt templates."
                },
                "pog.taskManager.jira.baseUrl": {
                    "type": "string",
                    "default": "",
                    "description": "Jira base URL (e.g. https://jira.company.com). Server / Data Center only."
                },
                "pog.taskManager.jira.defaultJql": {
                    "type": "string",
                    "default": "assignee=currentUser() AND status=\"To Do\"",
                    "description": "Default JQL prefilled when running Jira — Pull Todos."
                },
                "pog.taskManager.jira.pullProject": {
                    "type": "string",
                    "default": "jira",
                    "description": "Project folder under pog-task/list/ where pulled issues are written."
                },
                "pog.taskManager.jira.pullModule": {
                    "type": "string",
                    "default": "inbox",
                    "description": "Module folder under pog-task/list/<project>/ where pulled issues are written."
                },
                "pog.taskManager.jira.inReviewTransitionName": {
                    "type": "string",
                    "default": "In Review",
                    "description": "Jira transition name used when pushing a task with status=in_review."
                },
                "pog.taskManager.jira.doneTransitionName": {
                    "type": "string",
                    "default": "Done",
                    "description": "Jira transition name used when pushing a task with status=completed."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/js-yaml": "^4.0.9",
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.19.8",
        "@types/vscode": "^1.90.0",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^9.39.2",
        "ts-loader": "^9.5.4",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.54.0",
        "webpack": "^5.104.1",
        "webpack-cli": "^6.0.1"
    },
    "dependencies": {
        "js-yaml": "^4.1.1"
    }
}
